DirectoryIndex public/index.html index.html index.php
AddType application/manifest+json .webmanifest

RewriteEngine On
RewriteRule ^(?:\.env(?:\..*)?|\.git(?:/.*)?|app(?:/.*)?|src(?:/.*)?|test(?:/.*)?|scripts(?:/.*)?|database(?:/.*)?|node_modules(?:/.*)?|uploads(?:/.*)?)$ - [F,L,NC]
RewriteRule ^$ public/index.html [L]
RewriteRule ^(app\.js|ui-model\.js|lucide\.min\.js|styles\.css|finup-logo\.png|finup-favicon\.png|manifest\.webmanifest)$ public/$1 [L]
RewriteRule ^api/(.*)$ api.php?path=$1 [QSA,L]
